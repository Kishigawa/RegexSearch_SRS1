<Window x:Class="RegexSearch.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegexSearch.WPF"
        mc:Ignorable="d"
        Title="Обработка строки, описывающая идентификатор пользователя" Height="480" Width="820">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Поиск подстрок в тексте" FontSize="26" FontWeight="Bold" Foreground="Black"/>
            <TextBlock Text="Сравнение регулярного выражения и конечного автомата"
                       FontSize="13" Foreground="#65748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="7" Padding="12" Margin="0,0,0,12"
                BorderBrush="#DCE2EA" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Шаблон распознавания" FontWeight="SemiBold" Foreground="#34445A" Margin="0,0,0,6"/>
                <TextBlock Text="\bUSER_[0-9]{5,8}\b" FontFamily="Consolas" FontSize="15" Foreground="#1765A5"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                <Button Content="Поиск через Regex" Background="#2878C8" Foreground="White"
                        BorderThickness="0" Click="RegexButton_Click"/>
                <Button Content="Поиск через автомат" Background="#21875A" Foreground="White"
                        BorderThickness="0" Click="AutomatonButton_Click"/>
                <Button Content="Сравнить алгоритмы" Background="#6B62B5" Foreground="White"
                        BorderThickness="0" Click="CompareButton_Click"/>
                <Button Content="Очистить" Background="#E5E9EF" Foreground="#34445A"
                        BorderThickness="0" Click="ClearButton_Click"/>
            </WrapPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Исходный текст" Background="White">
                    <TextBox x:Name="InputText"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="14" Padding="8"
                             BorderBrush="#DCE2EA" BorderThickness="1" VerticalContentAlignment="Top"
                             Text="Корректные идентификаторы:&#10;USER_12345&#10;Пользователь USER_00123 вошел в систему.&#10;Логины: USER_1234567, USER_87654321.&#10;(USER_99999)&#10;id:USER_54321;&#10;&#10;Некорректные значения:&#10;USER_1234&#10;USER_123456789&#10;USER12345&#10;user_12345&#10;USER_12A45"/>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Результаты поиска" Background="White">
                    <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" FontSize="13" Background="White" BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="40"/>
                            <DataGridTextColumn Header="Совпадение" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Позиция" Binding="{Binding Position}" Width="65"/>
                            <DataGridTextColumn Header="Длина" Binding="{Binding Length}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#DCE2EA" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Text="Результаты поиска появятся здесь."
                           Foreground="#34445A" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Программа готова к работе."
                           Foreground="#21875A" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
